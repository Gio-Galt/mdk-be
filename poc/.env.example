# MDK POC — environment variables
# Copy this file to .env and fill in your values.
#
#   cp poc/.env.example poc/.env
#
# Shell environment variables always take precedence over values in this file.
# Lines starting with # are comments. Inline comments are supported after values.

# ── Ports ──────────────────────────────────────────────────────────────────────
# All optional. These are the defaults — only set if you need to change them.

PORT=3847            # Agent Studio / App Node
ORK_PORT=3848        # ORK Kernel
MINER_PORT=3850      # Miner Worker (10 × Whatsminer)
PM_PORT=3851         # Powermeter Worker (10 × Schneider PM8000)

# ── ORK URL (App Node → ORK) ───────────────────────────────────────────────────
# Change if you run the ORK on a different host/port than default.

# ORK_URL=http://127.0.0.1:3848

# ── LLM — OpenAI ───────────────────────────────────────────────────────────────
# Set OPENAI_API_KEY to enable LLM-powered intent resolution via OpenAI.
# Without any key the agent falls back to the built-in regex heuristic.

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini          # default
# OPENAI_BASE_URL=https://api.openai.com/v1  # override for compatible endpoints

# ── LLM — Anthropic ────────────────────────────────────────────────────────────

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022  # default

# ── LLM control ────────────────────────────────────────────────────────────────
# Force a specific provider when both keys are set.
# MDK_LLM_PROVIDER=openai     # or: anthropic

# ── Auth ────────────────────────────────────────────────────────────────────────
# In production (NODE_ENV=production) the API requires a bearer token.
# Development mode accepts any token (including empty).

# NODE_ENV=production
